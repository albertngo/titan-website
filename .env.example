# Titan Desk's Supabase project: the public catalogue view (api.catalogue_public).
# Both values are public by design (the anon role can only read the public tier);
# copy them from the titan-desk "web" Vercel project. Set them in Vercel, not in git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only: render the catalogue from a sample file instead of Supabase.
# CATALOGUE_FIXTURE=tests/fixtures/catalogue-SAMPLE-not-real.json

# Lead forms -> Make scenario "Website → GHL (titan-website forms)" (4997514) -> GHL.
# SECRET (server-only, never NEXT_PUBLIC_). Set them in Vercel only AFTER the scenario is
# switched on: a request to a scenario that is off waits in Make's queue and runs later.
# Until both are set, forms show "please call or email us".
LEAD_MAKE_HOOK=
LEAD_MAKE_KEY=
